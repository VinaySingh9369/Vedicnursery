  </div>
</footer>

<!-- ============ CART DRAWER ============ -->
<div class="overlay" id="overlay"></div>
<aside class="drawer" id="cartDrawer" role="dialog" aria-label="Your cart">
  <div class="drawer-head">
    <h3>Your Enquiry Cart</h3>
    <button class="drawer-close" id="drawerCloseBtn" aria-label="Close cart">×</button>
  </div>
  <div class="drawer-items" id="drawerItems">
    <p class="drawer-empty">No plants added yet.</p>
  </div>
  <div class="drawer-foot">
    <div class="drawer-total"><span>Total</span><span id="drawerTotal">₹0</span></div>
    <a href="#contact" class="btn btn-primary" style="width:100%;justify-content:center;" id="drawerCheckout">Send Enquiry →</a>
  </div>
</aside>

<script src="/js/script.js" defer></script>
</body>
