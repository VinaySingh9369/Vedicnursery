    </div>

    <div>
      <div class="sec-head" style="margin-bottom:22px;">
        <p class="sec-eyebrow"><b>Send an Enquiry</b></p>
        <h2 style="font-size:clamp(1.5rem,2.6vw,2rem);">We'll get back within a day</h2>
      </div>

              <% if (success_msg && success_msg.length > 0) { %>
            <div class="alert alert-success" style="display:block; padding:20px; margin:25px 0; background:#d4edda; color:#155724; border-radius:8px;">
              <%= success_msg[0] %>
            </div>
          <% } %>

          <% if (error_msg && error_msg.length > 0) { %>
            <div class="alert alert-danger" style="display:block; padding:20px; margin:25px 0; background:#f8d7da; color:#721c24; border-radius:8px;">
              <%= error_msg[0] %>
            </div>
          <% } %>

     
      <form class="contact-form" id="enquiryForm" action="/enquiry" method="POST">
        <input type="hidden" name="_subject" value="New enquiry — Organic Organic Vedic Nursery">
        <input type="hidden" name="_captcha" value="false">
        <input type="hidden" name="_template" value="table">

        <!-- <div class="cart-summary-box" id="formCartSummary">Your cart is empty — browse the vatika above and add a plant or two.</div> -->

        <div class="form-row">
          <div class="field">
            <label for="fName">Full name</label>
            <input type="text" id="fName" name="name" placeholder="Your name" required>
          </div>
          <div class="field">
            <label for="fPhone">Phone number</label>
            <input type="tel" id="fPhone" name="phone" placeholder="10-digit mobile number" pattern="[0-9+ -]{7,15}" required>
          </div>
        </div>

        <div class="field">
          <label for="fEmail">Email address</label>
          <input type="email" id="fEmail" name="email" placeholder="you@example.com" required>
        </div>

        <div class="field">
          <label for="fMsg">Message / plants you're interested in</label>
          <textarea id="fMsg" name="message" placeholder="Tell us a bit about your space, or any questions."></textarea>
        </div>

        <input type="hidden" name="Cart Items" id="fCartHidden" value="">

        <button type="submit" class="submit-btn">Send Enquiry</button>
        <p class="form-note">Your name, phone and email are sent directly to the  Nursery owner — never shared elsewhere.</p>
      </form>
    </div>
  </div>
</section>

<!-- ============ FOOTER ============ -->
<footer>
  <div class="wrap footer-inner">
